*.zip

# -----------------------------------------------------------------------
# Quartus Prime / Qsys / SOPC Builder / Nios II generated files.
# Only reproducible tool output is ignored here - RTL/HDL sources,
# .qsys/.qip/.mif/.tcl descriptors and hand-written software stay tracked.
# -----------------------------------------------------------------------

# Compilation databases, caches and editor state
**/db/
**/incremental_db/
**/greybox_tmp/
**/.qsys_edit/
**/.sopc_builder/

# Qsys-generated system sub-trees (regenerated from the .qsys file)
**/simulation/
**/synthesis/
**/testbench/
**/output_files/
*.sopcinfo

# Nios II software build output
**/*_bsp/
**/obj/
**/.metadata/
*.objdump
*.elf
*.map

# Compilation reports, logs and status files
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.qws
*.qmsg
*_log.txt
*_upgrade_log.txt
*_generation_script
hs_err_pid*.log

# Auto-generated assignment backups
*_assignment_defaults.qdf
*.bak
*~

# Programming files (bitstreams) - regenerated by compilation
*.sof
*.pof
*.jam
*.jbc
*.ekp
